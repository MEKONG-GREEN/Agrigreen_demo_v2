<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- CHỈ bản debug: cho HTTP rõ tới 127.0.0.1/localhost để kiểm thử tích hợp
         gọi máy chủ API giả trong tiến trình. Bản release không có cấu hình này
         (usesCleartextTraffic=false ở main). -->
    <application android:networkSecurityConfig="@xml/network_security_config_debug"/>
</manifest>
