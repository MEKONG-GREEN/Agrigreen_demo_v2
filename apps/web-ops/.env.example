# Chép thành .env.local khi chạy dev. Không đặt bí mật ở đây — client web-ops là public client + PKCE.

# Môi trường triển khai (src/deployEnv.ts): dev = máy cục bộ (`npm run build` cho phép http/localhost
# và giả lập); production|staging = bản thật (bắt buộc URL https, cấm giả lập); demo = bản giả lập.
NEXT_PUBLIC_DEPLOY_ENV=dev

# 1 = dữ liệu giả lập, không cần backend/Keycloak
NEXT_PUBLIC_API_MOCK=0

# Application API (api.<domain>) — api-platform AG_HTTP_ADDR
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Admin API (admin.<domain>, host riêng, bắt buộc MFA) — api-platform AG_ADMIN_HTTP_ADDR, mặc định :8082
NEXT_PUBLIC_ADMIN_API_BASE=http://localhost:8082

# Keycloak realm agrigreen (deploy/compose/keycloak/agrigreen-realm.json). Compose mở Keycloak ở 8180
# (8081 là API nội bộ MKG, không phải Keycloak).
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8180/realms/agrigreen
NEXT_PUBLIC_OIDC_CLIENT_ID=agrigreen-web-ops

# Style MapLibre của nhà cung cấp tile trong lãnh thổ (ADR-0007); bỏ trống = nền trơn
NEXT_PUBLIC_MAP_STYLE_URL=

# Khung KN v7.7: auto = menu theo cấu hình khi tài khoản có vai trò KN; legacy = luôn menu cũ
NEXT_PUBLIC_SURFACE=auto
# 1 = thêm nhóm 'Chức năng khác' (menu cũ) dưới menu KN
NEXT_PUBLIC_KN_LEGACY_MENU=
