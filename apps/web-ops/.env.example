# Chép thành .env.local khi chạy dev. Không đặt bí mật ở đây — client web-ops là public client + PKCE.

# 1 = dữ liệu giả lập, không cần backend/Keycloak
NEXT_PUBLIC_API_MOCK=0

# Application API (api.<domain>) — api-platform AG_HTTP_ADDR
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Admin API (admin.<domain>, host riêng, bắt buộc MFA) — api-platform AG_ADMIN_HTTP_ADDR, mặc định :8082
NEXT_PUBLIC_ADMIN_API_BASE=http://localhost:8082

# Keycloak realm agrigreen (deploy/compose/keycloak/agrigreen-realm.json)
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/agrigreen
NEXT_PUBLIC_OIDC_CLIENT_ID=agrigreen-web-ops

# Style MapLibre của nhà cung cấp tile trong lãnh thổ (ADR-0007); bỏ trống = nền trơn
NEXT_PUBLIC_MAP_STYLE_URL=
