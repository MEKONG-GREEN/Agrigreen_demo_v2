# Chép thành .env.local khi chạy dev. Không đặt bí mật ở đây — client web-internal là public client + PKCE.

# Môi trường triển khai (src/deployEnv.ts): dev = máy cục bộ (`npm run build` cho phép http/localhost
# và giả lập); production|staging = bản thật (bắt buộc URL https, cấm giả lập); demo = bản giả lập.
NEXT_PUBLIC_DEPLOY_ENV=dev

# 1 = dữ liệu giả lập, không cần api-internal/Keycloak
NEXT_PUBLIC_API_MOCK=0

# api-internal bề mặt ứng dụng (AG_HTTP_ADDR, mặc định :8081)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
# api-internal bề mặt quản trị (AG_ADMIN_HTTP_ADDR, mặc định :8083) — MFA bắt buộc
NEXT_PUBLIC_ADMIN_API_BASE=http://localhost:8083

# Keycloak realm agrigreen (deploy/compose/keycloak/agrigreen-realm.json; Compose mở 127.0.0.1:8180)
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8180/realms/agrigreen
NEXT_PUBLIC_OIDC_CLIENT_ID=agrigreen-web-internal
