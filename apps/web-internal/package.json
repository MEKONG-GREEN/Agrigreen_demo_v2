{
  "name": "@agrigreen/web-internal",
  "version": "0.1.0",
  "private": true,
  "description": "Web nội bộ Mekong Green (vùng mkg): hub/kho, cân và đối soát, lệnh gom — chỉ gọi api-internal",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:mock": "cross-env NEXT_PUBLIC_API_MOCK=1 next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "build:mock": "cross-env NEXT_PUBLIC_API_MOCK=1 next build",
    "start:e2e": "next start -p 3101",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../../contracts/openapi/mkg-internal.yaml -o src/api/generated/mkg-internal.ts",
    "check:api": "openapi-typescript ../../contracts/openapi/mkg-internal.yaml -o src/api/generated/mkg-internal.ts --check"
  },
  "dependencies": {
    "next": "16.3.6",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
