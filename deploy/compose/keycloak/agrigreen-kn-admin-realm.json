{
  "realm": "agrigreen-kn-admin",
  "enabled": true,
  "displayName": "AgriGreen KN — Quản trị (realm riêng, Local/Dev)",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "${AG_SMTP_HOST:}", "port": "${AG_SMTP_PORT:587}", "from": "${AG_SMTP_FROM:}",
    "user": "${AG_SMTP_USERNAME:}", "password": "${AG_SMTP_PASSWORD:}",
    "auth": "${AG_KC_SMTP_AUTH:true}", "starttls": "${AG_KC_SMTP_STARTTLS:true}", "ssl": "${AG_KC_SMTP_SSL:false}"
  },
  "loginWithEmailAllowed": true,
  "loginTheme": "agrigreen",
  "eventsEnabled": true,
  "eventsExpiration": 31536000,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "CODE_TO_TOKEN_ERROR", "UPDATE_PASSWORD", "UPDATE_TOTP", "REMOVE_TOTP"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "maxDeltaTimeSeconds": 86400,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 300,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 300,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 28800,
  "passwordPolicy": "length(14) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and notEmail and passwordHistory(10) and forceExpiredPasswordChange(60)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "kn-admin browser",
  "internationalizationEnabled": true,
  "supportedLocales": ["vi", "en"],
  "defaultLocale": "vi",
  "attributes": {
    "policy_note": "D24 + D25 (CEO 13/10/2026; QĐ-3 b + realm quản trị riêng, QĐ-4 c): realm quản trị RIÊNG của hệ thống thông tin KN. Chính sách mật khẩu v4.3 P-3 cho quản trị (Keycloak đặt theo realm nên không áp được cho riêng vai trong realm agrigreen): ≥ 14 ký tự, có chữ hoa, chữ thường, chữ số, ký tự đặc biệt, không trùng tên đăng nhập/email, không trùng 10 mật khẩu gần nhất, đổi sau 60 ngày. TOTP bắt buộc với MỌI tài khoản (luồng 'kn-admin browser', OTP Form REQUIRED — chưa có thì đăng ký ở lần đăng nhập đầu). Phiên quản trị 5 phút không thao tác, tối đa 8 giờ (v4.3 P-5, Q-016 đề xuất quản trị 5 phút — giả định docs/kn/gia-dinh/MFA.md). Realm agrigreen (cán bộ, nông hộ) GIỮ mật khẩu 12 ký tự/không trùng 5 và phiên 4 giờ/24 giờ (D9). Backend CHƯA nhận token của realm này: nối issuer thứ hai cho Admin API là việc W10.01/W10.03 (docs/runbooks/keycloak-mfa-d24.md mục 5)."
  },
  "roles": {
    "realm": [
      { "name": "platform_admin", "description": "[MFA] Quản trị nền tảng hệ KN (realm quản trị riêng, D25)" },
      { "name": "account_admin", "description": "[MFA] Quản trị tài khoản toàn quốc hệ KN (realm quản trị riêng, D25)" },
      { "name": "account_admin_province", "description": "[MFA] Quản trị tài khoản một tỉnh hệ KN (realm quản trị riêng, D25)" }
    ]
  },
  "defaultDefaultClientScopes": ["basic", "roles", "web-origins", "profile", "agrigreen-claims"],
  "defaultOptionalClientScopes": [],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant (UUID)\",\"validations\":{\"pattern\":{\"pattern\":\"^[0-9a-fA-F-]{36}$\",\"error-message\":\"tenant_id phải là UUID\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"org_ref\",\"displayName\":\"Đơn vị công tác (org_ref, UUID)\",\"validations\":{\"pattern\":{\"pattern\":\"^[0-9a-fA-F-]{36}$\",\"error-message\":\"org_ref phải là UUID\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "authenticatorConfig": [
    { "alias": "agrigreen-amr-pwd", "config": { "default.reference.value": "pwd", "default.reference.maxAge": "86400" } },
    { "alias": "agrigreen-amr-otp", "config": { "default.reference.value": "otp", "default.reference.maxAge": "86400" } }
  ],
  "authenticationFlows": [
    {
      "alias": "kn-admin browser",
      "description": "D24/D25: realm quản trị — cookie hoặc mật khẩu + TOTP BẮT BUỘC cho mọi tài khoản (chưa có thì đăng ký ở lần đăng nhập đầu)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "autheticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "flowAlias": "kn-admin browser forms", "authenticatorFlow": true, "autheticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "kn-admin browser forms",
      "description": "Mật khẩu rồi OTP Form REQUIRED",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "authenticatorConfig": "agrigreen-amr-pwd", "authenticatorFlow": false, "autheticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorConfig": "agrigreen-amr-otp", "authenticatorFlow": false, "autheticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "profile", "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "username", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" } }
      ]
    },
    {
      "name": "basic",
      "description": "sub và auth_time",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": { "access.token.claim": "true", "introspection.token.claim": "true" } },
        { "name": "auth_time", "protocol": "openid-connect", "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": { "user.session.note": "AUTH_TIME", "claim.name": "auth_time", "jsonType.label": "long", "id.token.claim": "true", "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "roles",
      "description": "Vai realm vào realm_access.roles",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "realm roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "realm_access.roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "web-origins",
      "description": "allowed-origins trong token",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "allowed web origins", "protocol": "openid-connect", "protocolMapper": "oidc-allowed-origins-mapper", "config": { "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "agrigreen-claims",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        { "name": "tenant_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "tenant_id", "claim.name": "tenant_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" } },
        { "name": "org_ref", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "org_ref", "claim.name": "org_ref", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" } },
        { "name": "audience agrigreen-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "agrigreen-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "amr", "protocol": "openid-connect", "protocolMapper": "oidc-amr-mapper", "config": { "access.token.claim": "true", "id.token.claim": "true" } }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agrigreen-kn-admin-web",
      "name": "Web vận hành — đăng nhập quản trị hệ KN (realm quản trị riêng)",
      "description": "Client công khai PKCE cho màn quản trị của web-ops khi Admin API nhận issuer realm quản trị (W10.01/W10.03). Chưa có client nào dùng ở G1.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*", "client.session.idle.timeout": "300", "client.session.max.lifespan": "28800" },
      "defaultClientScopes": ["basic", "roles", "web-origins", "profile", "agrigreen-claims"]
    }
  ]
}
