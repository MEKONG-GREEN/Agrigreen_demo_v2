# Cổng vào duy nhất của VPS (docker-compose.vps.yml). TLS tự động (Let's Encrypt).
# Biến: AG_DOMAIN, ACME_EMAIL, ADMIN_ALLOW_CIDR (một hoặc nhiều CIDR, cách nhau bởi dấu cách).
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		# includeSubDomains chỉ phủ tên con CỦA CHÍNH host gửi header (vd *.api.<domain>) — mọi host ở đây đều
		# là lá, chỉ phục vụ HTTPS qua Caddy, nên an toàn. Chưa thêm preload (cần đăng ký và khó rút lại).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Chỉ cho host API (JSON, không giao diện): cấm nhúng khung, cấm đoán kiểu, CSP chặn mọi tài nguyên.
# KHÔNG áp cho app. (Next.js tự đặt X-Frame-Options SAMEORIGIN — gia hạn token im lặng chạy trong iframe
# cùng gốc /login/silent) và auth. (Keycloak tự đặt X-Frame-Options/CSP frame-ancestors cho iframe phiên).
(api_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	}
}

app.{$AG_DOMAIN} {
	import common
	reverse_proxy web-ops:3000
}

api.{$AG_DOMAIN} {
	import common
	import api_headers
	reverse_proxy api-platform:8080
}

# Admin API (MFA bắt buộc ở tầng ứng dụng) — thêm lớp chặn theo IP.
admin.{$AG_DOMAIN} {
	import common
	import api_headers
	@outside not remote_ip {$ADMIN_ALLOW_CIDR}
	respond @outside 403
	reverse_proxy api-platform:8082
}

auth.{$AG_DOMAIN} {
	import common
	# Bảng điều khiển quản trị Keycloak chỉ từ mạng quản trị; đăng nhập người dùng (/realms/…) mở.
	@kcadmin {
		path /admin /admin/*
		not remote_ip {$ADMIN_ALLOW_CIDR}
	}
	respond @kcadmin 403
	reverse_proxy keycloak:8080
}

# SigV4 bao gồm Host: giữ host công khai khi chuyển tới S3 nội bộ.
# Bucket không công khai: chỉ GET/HEAD có chữ ký, không mở thao tác quản trị/ghi.
files.{$AG_DOMAIN} {
 import common
 @read method GET HEAD
 handle @read {
  reverse_proxy seaweedfs:9000 {
   header_up Host {http.request.host}
  }
 }
 respond 405
}
