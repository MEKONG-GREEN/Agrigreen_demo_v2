# Sao chép thành .env (đã có trong .gitignore) và điền giá trị. KHÔNG commit .env.
# Mọi mật khẩu dưới đây chỉ dùng cho Local/Dev với dữ liệu tổng hợp.

PG_SUPERUSER_PASSWORD=
AG_PG_ADMIN_URL=postgres://postgres:${PG_SUPERUSER_PASSWORD}@postgres:5432/postgres?sslmode=disable

# Mật khẩu vai DB: đặt riêng từng vai bằng AG_DB_PASSWORD_<VAI>, hoặc một giá trị chung cho dev.
AG_DB_APP_PASSWORD=

# Migrator nối thẳng PostgreSQL; ứng dụng đi qua PgBouncer.
AG_DB_URL=postgres://postgres:5432/?sslmode=disable
AG_PF_DB_URL=postgres://pgbouncer:6432/?sslmode=disable
AG_DB_VIA_PGBOUNCER=1

AMQP_PASSWORD=
AG_AMQP_URL=amqp://agrigreen:${AMQP_PASSWORD}@rabbitmq:5672/

KEYCLOAK_ADMIN_PASSWORD=
AG_OIDC_ISSUER=http://keycloak:8080/realms/agrigreen
AG_OIDC_AUDIENCE=agrigreen-api

MINIO_PASSWORD=
