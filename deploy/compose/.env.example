# Mẫu deploy/compose/.env cho Docker Compose Local/Dev. KHÔNG điền tay, KHÔNG commit .env:
#   ./scripts/gen-dev-secrets.ps1        (Windows PowerShell)
#   sh scripts/gen-dev-secrets.sh        (Linux, macOS, CI)
# Script sinh giá trị ngẫu nhiên cho mọi biến dưới đây. Chỉ dùng với dữ liệu tổng hợp (mục 21).
# Địa chỉ nội bộ (URL DB, AMQP, OIDC, S3) nằm sẵn trong docker-compose.yml, không cần đặt ở đây.

# PostgreSQL superuser — chỉ migrate-bootstrap dùng (tạo vai, database).
PG_SUPERUSER_PASSWORD=
# Mật khẩu chung của các vai ứng dụng cụm pf/mkg (platform_api, party_app, …, ag_migrator, ag_outbox_publisher).
AG_DB_APP_PASSWORD=
# Vai vault_app riêng (R-04): chỉ pgbouncer, migrate-bootstrap và identity-vault nhận biến này.
AG_DB_PASSWORD_VAULT_APP=

AMQP_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# MinIO: tài khoản gốc (chỉ minio, minio-init) và tài khoản ứng dụng agrigreen-app (chỉ Get/Put).
MINIO_ROOT_PASSWORD=
S3_APP_SECRET_KEY=

# Khóa HMAC của cursor đồng bộ (pf/sync).
AG_SYNC_CURSOR_KEY=
# Kho định danh: KEK dev và khóa chỉ mục mù — base64 chuẩn của 32 byte, hai khóa KHÁC nhau.
AG_VAULT_KEK=
AG_VAULT_BLIND_KEY=
# Khóa ký manifest neo chuỗi: Ed25519 seed 32 byte, base64 chuẩn.
AG_ANCHOR_SIGNING_KEY=
# Public API (G5, --profile phasek): pepper HMAC khóa API phiên bản 1, ≥ 32 byte (ADR-0022 mục 4).
AG_APIKEY_PEPPER_V1=

# Sao lưu (docker-compose.backup.yml, docs/runbooks/backup.md): mật khẩu mã hóa kho pgBackRest,
# kho S3 thứ hai: tài khoản gốc, backup-writer (chỉ ghi sao lưu), restore-reader (chỉ đọc khi phục hồi).
PGBACKREST_CIPHER_PASS=
BACKUP_S3_ROOT_SECRET=
S3_BACKUP_WRITER_SECRET=
S3_RESTORE_READER_SECRET=

# Tùy chọn (có mặc định trong docker-compose.yml):
# AG_S3_BUCKET=agrigreen
# AG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Địa chỉ bind của cổng nhận lô mTLS 8443 (cmd/ingest). VPS: IP giao diện VPN/OT, KHÔNG 0.0.0.0.
# AG_INGEST_BIND_ADDR=127.0.0.1
# Nền tảng → MKG (ADR-0020, MKG là tenant riêng): api-internal đọc /v1/partner/* của api-platform bằng
# tài khoản dịch vụ agrigreen-mkg-sync (bí mật lấy ở trang quản trị Keycloak; thuộc tính tenant_id của
# service-account-agrigreen-mkg-sync = AG_MKG_TENANT_ID). Tenant chương trình phải duyệt cấp quyền chia
# sẻ cho AG_MKG_TENANT_ID trước (POST /v1/share-grants, người đề xuất ≠ người duyệt).
# AG_PLATFORM_API_URL=http://api-platform:8080
# AG_MKG_SA_CLIENT_SECRET=
# AG_MKG_TENANT_ID=
# AG_PARTNER_GRANTOR_TENANT=
# Phase K (docs/runbooks/phase-k.md): tenant đơn vị vận hành Public API; enforce cho điểm kiểm soát xuất.
# AG_PUBLIC_OPERATOR_TENANT=
# AG_EGRESS_MODE=enforce
# AG_VALKEY_URL=redis://valkey:6379/0
# AG_PUBLIC_OIDC_ISSUER=
# AG_PUBLIC_OIDC_AUDIENCE=
