{
  "x-event-type": "mkg.depot.site.published",
  "x-schema-version": 1,
  "type": "object",
  "required": ["site_ref", "code"],
  "properties": {
    "site_ref":    { "type": "string", "format": "uuid" },
    "code":        { "type": "string" },
    "location":    { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
    "capacity_kg": { "type": "string" },
    "tags":        { "type": "array", "items": { "type": "string" } },
    "zones":       { "type": "array", "items": { "type": "object", "properties": { "code": { "type": "string" }, "area": { "type": "integer" } } } },
    "note":        { "type": ["string", "null"] },
    "debug_trace": { "type": "string" }
  }
}
