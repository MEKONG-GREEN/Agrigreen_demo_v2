{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrigreen.vn/events/pf.cropcycle.collection_statement.received/v1",
  "title": "pf.cropcycle.collection_statement.received — payload",
