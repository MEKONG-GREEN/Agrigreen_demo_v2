{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrigreen.vn/events/pf.accounts.assignment.changed/v1",
  "title": "pf.accounts.assignment.changed — payload",
  "description": "KN v7.7 FN-AD-04.04: Admin sửa một lần gán vai trò (Nút, phòng ban, cấp quản lý, xã phụ trách, hiệu lực). Trạng thái SAU khi sửa; không chứa dữ liệu cá nhân.",
  "x-event-type": "pf.accounts.assignment.changed",
  "x-schema-version": 1,
  "x-producer": "pf/accounts",
  "type": "object",
  "required": ["assignment_id", "user_ref", "role", "org_ref", "department_codes", "commune_codes", "active", "actor_ref", "event_time", "seq"],
  "properties": {
    "assignment_id": {"type": "string", "format": "uuid"},
    "user_ref": {"type": "string", "format": "uuid", "description": "id người dùng trong Keycloak"},
    "role": {"type": "string", "enum": ["kn_tw", "kn_tinh", "kn_xa", "admin"]},
    "org_ref": {"type": ["string", "null"], "format": "uuid", "description": "Nút của vai trò; null với admin"},
    "department_codes": {"type": "array", "items": {"type": "string"}},
    "commune_codes": {"type": "array", "items": {"type": "string"}},
    "active": {"type": "boolean"},
    "actor_ref": {"type": "string", "format": "uuid"},
    "event_time": {"type": "string", "format": "date-time"},
    "seq": {"type": "integer", "minimum": 1}
  }
}
