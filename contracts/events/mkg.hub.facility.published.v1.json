{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrigreen.vn/events/mkg.hub.facility.published/v1",
  "title": "mkg.hub.facility.published — payload",
  "description": "Payload đi qua van công bố hub_facility v1 (contracts/publication/hub_facility.json). Phát khi một phiên bản dữ liệu chủ cơ sở MKG được phê duyệt. Bản ghi xuất nằm ở sổ mkg_hub.valve_export; event_id = id bản ghi xuất.",
  "x-event-type": "mkg.hub.facility.published",
  "x-schema-version": 1,
  "x-producer": "mkg/hub",
  "x-publication": "hub_facility",
  "type": "object",
  "required": ["hub_ref", "code", "name", "kind", "location", "province_code", "status", "capacity_tons", "unit", "effective_from"],
  "properties": {
    "hub_ref":        { "type": "string", "format": "uuid" },
    "code":           { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$" },
    "name":           { "type": "string" },
    "kind":           { "type": "string", "enum": ["hub", "warehouse", "yard"] },
    "location": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "boundary": {
      "type": ["object", "null"],
      "required": ["type", "coordinates"],
      "properties": {
        "type":        { "type": "string", "enum": ["MultiPolygon"] },
        "coordinates": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } } } }
      }
    },
    "province_code":  { "type": "string", "pattern": "^[0-9]{2}$" },
    "status":         { "type": "string", "enum": ["active", "inactive"] },
    "capacity_tons":  { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "unit":           { "type": "string", "enum": ["t"] },
    "effective_from": { "type": "string", "format": "date-time" }
  }
}
