{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrigreen.vn/events/pf.cropcycle.season.completed/v1",
  "title": "pf.cropcycle.season.completed — payload",
  "description": "Vụ hoàn thành do khai sản lượng, cùng giao dịch (HTX US-YIELD-01 AC-2).",
  "x-event-type": "pf.cropcycle.season.completed",
  "x-schema-version": 1,
  "x-producer": "pf/cropcycle",
  "type": "object",
  "required": [
    "season_ref",
    "event_id",
    "plot_ref",
    "household_ref",
    "cooperative_ref",
    "commune_code",
    "season_code",
    "season_year",
    "variety_code",
    "harvest_id",
    "harvest_date",
    "area_ha",
    "actor_ref",
    "event_time"
  ],
  "properties": {
    "season_ref": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "plot_ref": {
      "type": "string",
      "format": "uuid"
    },
    "household_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "cooperative_ref": {
      "type": "string",
      "format": "uuid"
    },
    "commune_code": {
      "type": "string"
    },
    "season_code": {
      "type": "string"
    },
    "season_year": {
      "type": "integer"
    },
    "variety_code": {
      "type": "string"
    },
    "harvest_id": {
      "type": "string",
      "format": "uuid"
    },
    "harvest_date": {
      "type": "string",
      "format": "date"
    },
    "area_ha": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{4}$",
      "description": "decimal dạng chuỗi (ha)"
    },
    "actor_ref": {
      "type": "string",
      "format": "uuid"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
