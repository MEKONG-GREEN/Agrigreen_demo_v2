{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrigreen.vn/events/pf.extension.work_schedule.reviewed/v1",
  "title": "pf.extension.work_schedule.reviewed — payload",
  "description": "Kết quả duyệt lịch công tác tuần (KN v7.7 FN-TI-02.07): approved hoặc change_requested kèm lý do bắt buộc. Người duyệt khác người đăng ký (R-56). auto = lịch cán bộ Cấp Tỉnh tự duyệt khi gửi (tham số Q-16). Consumer pf/notify báo người đăng ký kèm lý do (FN-XA-03.08 AC). Lý do đã chặn SĐT/CCCD ở tầng ứng dụng.",
  "x-event-type": "pf.extension.work_schedule.reviewed",
  "x-schema-version": 1,
  "x-producer": "pf/extension",
  "type": "object",
  "required": [
    "schedule_id",
    "owner_ref",
    "reviewer_ref",
    "department_code",
    "province_code",
    "week_start",
    "version",
    "decision",
    "reason",
    "auto",
    "event_time"
  ],
  "properties": {
    "schedule_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_ref": {
      "type": "string",
      "format": "uuid"
    },
    "reviewer_ref": {
      "type": "string",
      "format": "uuid"
    },
    "department_code": {
      "type": "string"
    },
    "province_code": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "change_requested"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "auto": {
      "type": "boolean"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
