{
  "name": "collection_volume_by_commune",
  "version": 1,
  "kind": "feed",
  "flow": "licensed",
  "status": "proposed",
  "pending": ["A7", "C-4", "K-8"],
  "status_note": "Thay sản phẩm dữ liệu collection_volume sau một kỳ chạy song song (ADR-0035 §4). Ngưỡng k chưa ký (C-4/K-8), tạm 10. Người đề xuất/phê duyệt là vai giữ chỗ.",
  "owner": "pf/apiclient",
  "sources": ["pf/cropcycle", "pf/geo", "pf/masterdata"],
  "consumers": ["bên thứ ba có cấp phép aggregate"],
  "proposed_by": "pf-apiclient-module-owner",
  "approved_by": "data-steward-don-vi-van-hanh",
  "approved_at": "2026-10-06",
  "purpose": "Nhà máy/bên mua cần nguồn rơm đã gom theo xã, vụ, tháng. Chỉ số TỔNG HỢP, mỗi ô ≥ k nông hộ phân biệt; không thửa, nông hộ, HTX, khối lượng cân, giá hay khách hàng MKG.",
  "personal_data": false,
  "grant_class": "aggregate",
  "entity_key": ["area_code", "season_code", "period_month"],
  "freshness": { "max_age": "P1D" },
  "delivery": { "cursor": true, "retention_days": 30, "dataset_versioned": true, "snapshot": "signed_url", "webhook": "thin", "channels": ["api", "file"] },
  "aggregation": {
    "k_param": "publicdata.k_min",
    "k_default": 10,
    "k_status": "tạm — chờ ký C-4/K-8 (Q5-3)",
    "unit": "household",
    "suppression": "omit",
    "complementary_suppression": true,
    "hysteresis": 2,
    "grain": "commune × season × month"
  },
  "replaces": ["dataproduct/collection_volume"],
  "description": "Một ô: số cuộn và diện tích thửa đã gom trong một xã, một vụ, một tháng (giờ Việt Nam). Quy tắc ẩn như harvest_progress_by_commune.",
  "type": "object",
  "required": ["area_code", "area_level", "province_code", "admin_unit_valid_from", "season_code", "period_month", "rolls_collected", "area_ha_collected"],
  "properties": {
    "area_code":             { "type": "string", "pattern": "^[0-9]{2}([0-9]{3})?$" },
    "area_level":            { "type": "string", "enum": ["commune", "province_withheld"] },
    "province_code":         { "type": "string", "pattern": "^[0-9]{2}$" },
    "admin_unit_valid_from": { "type": "string", "format": "date" },
    "season_code":           { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
    "period_month":          { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "rolls_collected":       { "type": "integer" },
    "area_ha_collected":     { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }
  }
}
