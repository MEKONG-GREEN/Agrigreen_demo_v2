{
  "name": "season_harvest_dates",
  "version": 1,
  "kind": "feed",
  "flow": "licensed",
  "status": "proposed",
  "pending": ["A7"],
  "status_note": "Thay GET /v1/partner/season-harvest-dates (ADR-0033 §2, §7: chạy song song tới W5.10). Người đề xuất/phê duyệt là vai giữ chỗ.",
  "owner": "pf/apiclient",
  "sources": ["pf/cropcycle"],
  "consumers": ["mkg/fieldops"],
  "proposed_by": "pf-cropcycle-module-owner",
  "approved_by": "data-steward-tenant-chuong-trinh",
  "approved_at": "2026-10-06",
  "purpose": "MKG lập lịch gom theo ngày gieo và ngày gặt dự kiến của thửa thuộc HTX đã cấp phép season_harvest_dates (FM-01/02). Tập dữ liệu theo bên cấp; chỉ ngày và trạng thái vụ — không nông hộ, không sản lượng.",
  "personal_data": false,
  "grant_class": "partner",
  "grant_kind": "season_harvest_dates",
  "entity_key": ["season_ref"],
  "freshness": { "max_age": "P1D" },
  "delivery": { "cursor": true, "retention_days": 30, "dataset_versioned": false, "snapshot": "signed_url", "webhook": "thin", "channels": ["api", "file"] },
  "description": "Một vụ của một thửa: ngày gieo, ngày gặt dự kiến, ngày mở gặt và trạng thái. Bản mới nhất theo season_ref thay bản cũ.",
  "type": "object",
  "required": ["season_ref", "plot_ref", "cooperative_ref", "commune_code", "season_code", "season_year", "sowing_date", "expected_harvest_date", "harvest_open_date", "status", "completed_at"],
  "properties": {
    "season_ref":            { "type": "string", "format": "uuid" },
    "plot_ref":              { "type": "string", "format": "uuid" },
    "cooperative_ref":       { "type": "string", "format": "uuid" },
    "commune_code":          { "type": "string", "pattern": "^[0-9]{5}$" },
    "season_code":           { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
    "season_year":           { "type": "integer" },
    "sowing_date":           { "type": "string", "format": "date" },
    "expected_harvest_date": { "type": "string", "format": "date" },
    "harvest_open_date":     { "type": "string", "format": "date" },
    "status":                { "type": "string", "enum": ["open", "completed", "cancelled"] },
    "completed_at":          { "type": ["string", "null"], "format": "date-time" }
  }
}
