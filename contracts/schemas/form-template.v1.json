{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrigreen.vn/schemas/form-template/v1",
  "title": "form-template.v1 — định nghĩa lưới mẫu báo cáo KN v7.7",
  "description": "Hợp đồng lưới mẫu báo cáo dạng Excel (FN-AD-04.06, FN-XA-03.02) cho web-ops, field-app và P4. Sinh từ contracts/openapi/application.yaml (components.schemas Form*) — sửa ở OpenAPI rồi sinh lại. Số là chuỗi decimal, không float (R-10).",
  "$ref": "#/$defs/FormDefinition",
  "$defs": {
    "FormDefinition": {
      "type": "object",
      "description": "Định nghĩa lưới của một phiên bản mẫu, đúng bố cục sheet Excel (FN-AD-04.06, FN-XA-03.02). Cột theo chữ cái\nExcel liên tục từ A; tiêu đề nhiều tầng có vùng gộp (dòng tính từ 1 trong khung tiêu đề); công thức chạy trên\nmột dòng, tham chiếu \"F#\" = cột F cùng dòng. Hiển thị: xám = fixed, trắng viền = input, viền xanh đậm = cột theo kỳ\nđang mở, xám nhạt = kỳ khác, xanh lá nhạt = formula; cố định cột tới freeze_through; nhóm cột cho \"Đi tới\".\nPhần chưa biết từ tệp gốc: cột placeholder = true và mục pending (chờ khách Q-01).\n",
      "required": [
        "schema",
        "code",
        "title",
        "sheet_name",
        "requirements",
        "columns",
        "header",
        "period_blocks",
        "rows",
        "totals",
        "groups",
        "freeze_through",
        "rules",
        "pending",
        "completeness"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "form-template.v1"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.-]{1,31}$"
        },
        "title": {
          "type": "string",
          "maxLength": 300,
          "description": "Có thể chứa {season} — thay theo vụ khi dựng layout"
        },
        "sheet_name": {
          "type": "string",
          "maxLength": 100
        },
        "requirements": {
          "type": "string",
          "maxLength": 4000,
          "description": "“Yêu cầu biểu mẫu” nguyên văn"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/FormColumn"
          }
        },
        "header": {
          "type": "object",
          "required": [
            "rows",
            "cells",
            "merges"
          ],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "cells": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FormHeaderCell"
              }
            },
            "merges": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}[1-9][0-9]*:[A-Z]{1,3}[1-9][0-9]*$"
              },
              "examples": [
                [
                  "F1:L1",
                  "A1:A2"
                ]
              ]
            }
          }
        },
        "period_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormPeriodBlock"
          }
        },
        "rows": {
          "type": "object",
          "required": [
            "kind",
            "indicators"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "per_commune"
              ]
            },
            "indicators": {
              "type": "array",
              "description": "Rỗng: mỗi xã một dòng. Có: mỗi xã × mỗi chỉ tiêu một dòng (vd T05: 20 đối tượng sâu bệnh)",
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "label"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "label": {
                    "type": "string"
                  },
                  "catalog": {
                    "type": "string"
                  },
                  "placeholder": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "totals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "label",
              "label_letter"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "region",
                  "province"
                ]
              },
              "label": {
                "type": "string",
                "description": "“Cộng {region}”, “Toàn tỉnh”"
              },
              "label_letter": {
                "type": "string"
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "freeze_through": {
          "type": "string",
          "description": "Cố định tới cột này (vd J); rỗng = không"
        },
        "rules": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/FormRule"
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "part",
              "detail",
              "question"
            ],
            "properties": {
              "part": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "question": {
                "type": "string",
                "examples": [
                  "Q-01"
                ]
              }
            }
          }
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "placeholder"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "seed",
                "import",
                "designer"
              ]
            },
            "file": {
              "type": "string"
            },
            "sheet": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "data_row": {
              "type": "integer"
            },
            "seed_note": {
              "type": "string"
            }
          }
        }
      }
    },
    "FormColumn": {
      "type": "object",
      "required": [
        "letter",
        "title",
        "kind",
        "dtype"
      ],
      "properties": {
        "letter": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}$"
        },
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "kind": {
          "type": "string",
          "enum": [
            "fixed",
            "provincial",
            "input",
            "per_period",
            "formula"
          ],
          "description": "Cố định / Tỉnh giao / Nhập / Cột theo kỳ / Công thức"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "number",
            "integer",
            "text",
            "date",
            "catalog"
          ]
        },
        "unit": {
          "type": "string",
          "examples": [
            "ha",
            "tấn",
            "tấn/ha",
            "%"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "catalog": {
          "type": "string"
        },
        "formula": {
          "type": "string",
          "description": "Tập con Excel: + - * / ^ & % so sánh, SUM MIN MAX AVERAGE COUNT ROUND ROUNDUP ROUNDDOWN ABS IF IFERROR AND OR NOT ISBLANK ISNUMBER; tham chiếu F#, dải F#:L#",
          "examples": [
            "SUM(F#:L#)",
            "IF(G#=0,0,I#/G#)"
          ]
        },
        "fixed_source": {
          "type": "string",
          "description": "row_no | region_name | commune_name | indicator_label | none | xref:<mẫu>:<cột>"
        },
        "period_block": {
          "type": "string"
        },
        "period_slot": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "string",
          "enum": [
            "sum",
            "formula",
            "none"
          ],
          "description": "Dòng tổng: rỗng = sum cho cột số, formula cho cột công thức"
        },
        "min": {
          "type": "string",
          "description": "decimal"
        },
        "max": {
          "type": "string",
          "description": "decimal"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "group": {
          "type": "string"
        },
        "placeholder": {
          "type": "boolean",
          "description": "Chưa biết từ tệp gốc — chờ khách Q-01"
        },
        "note": {
          "type": "string"
        },
        "inactive": {
          "type": "boolean",
          "description": "Chỉ ở layout: khe kỳ vượt số kỳ của đợt"
        }
      }
    },
    "FormHeaderCell": {
      "type": "object",
      "required": [
        "row",
        "letter",
        "text"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "letter": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "period_block": {
          "type": "string"
        },
        "period_slot": {
          "type": "integer"
        }
      }
    },
    "FormPeriodBlock": {
      "type": "object",
      "required": [
        "id",
        "first_letter",
        "width",
        "slots",
        "title_pattern"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "first_letter": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Số cột mỗi kỳ (PL 07: 4)"
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "description": "Số kỳ tối đa"
        },
        "title_pattern": {
          "type": "string",
          "examples": [
            "Tuần {n}"
          ]
        }
      }
    },
    "FormRule": {
      "type": "object",
      "required": [
        "id",
        "expr",
        "message",
        "severity",
        "letters"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "expr": {
          "type": "string",
          "description": "Biểu thức logic trên dòng; được dùng XREF(\"T01\",\"M\") (liên biểu cùng xã cùng kỳ)",
          "examples": [
            "J#=XREF(\"T01\",\"M\")"
          ]
        },
        "when": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "letters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FormEvalInput": {
      "type": "object",
      "required": [
        "mode",
        "rows"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "draft",
            "submit"
          ],
          "description": "draft bỏ kiểm bắt buộc"
        },
        "open_slots": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "description": "Khe kỳ đang mở; null = không kiểm (xem trước)"
        },
        "rows": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "required": [
              "commune",
              "input"
            ],
            "properties": {
              "key": {
                "type": "string",
                "description": "Mặc định <mã xã> hoặc <mã xã>/<mã chỉ tiêu>"
              },
              "commune": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "indicator": {
                "type": "string"
              },
              "input": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Ô người nhập: chữ cái → giá trị (số dạng chuỗi decimal, ngày YYYY-MM-DD)"
              },
              "system": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Ô hệ thống: cố định + Tỉnh giao"
              },
              "xrefs": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "description": "Mã mẫu → cột → giá trị (cùng xã cùng kỳ)"
              }
            }
          }
        }
      }
    },
    "FormEvalResult": {
      "type": "object",
      "required": [
        "valid",
        "rows",
        "issues",
        "totals"
      ],
      "properties": {
        "valid": {
          "type": "boolean",
          "description": "Không có vấn đề mức error — được gửi"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "commune",
              "cells"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "commune": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "indicator": {
                "type": "string"
              },
              "cells": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "row_key",
              "code",
              "message",
              "severity"
            ],
            "properties": {
              "row_key": {
                "type": "string"
              },
              "letter": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "enum": [
                  "reports.row_invalid",
                  "reports.cell_unknown_column",
                  "reports.cell_not_editable",
                  "reports.cell_period_closed",
                  "reports.cell_invalid_type",
                  "reports.cell_out_of_range",
                  "reports.cell_required",
                  "reports.formula_error",
                  "reports.rule_failed",
                  "reports.rule_error",
                  "reports.form_invalid"
                ]
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "rule_id": {
                "type": "string"
              }
            }
          }
        },
        "totals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "members",
              "cells"
            ],
            "properties": {
              "key": {
                "type": "string",
                "examples": [
                  "region:KV1",
                  "province",
                  "province/SB01"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "region",
                  "province"
                ]
              },
              "region": {
                "type": "string"
              },
              "indicator": {
                "type": "string"
              },
              "members": {
                "type": "integer"
              },
              "cells": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
