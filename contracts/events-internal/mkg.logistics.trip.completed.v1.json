{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agrigreen.vn/events-internal/mkg.logistics.trip.completed/v1",
  "title": "mkg.logistics.trip.completed — payload (sự kiện NỘI BỘ MKG)",
  "description": "Một chuyến (xe, ghe, sà lan) hoàn tất: khối lượng thật theo phiếu cân và cước thực tế đã chốt; hoặc bản bù sửa sai (supersedes_id). Chặng mang km và tham chiếu kết quả định tuyến đã lưu bền vững (mục 16). Chỉ vhost mkg.internal (ADR-0018) — cước, phương tiện KHÔNG BAO GIỜ qua van. Người nhận: mkg/costing (phân bổ cước đa chặng về lô). Proto FM-05 (mỗi lượt xuống ghe một chuyến đường thủy), GH-03 (cước theo đơn giá thuê ghe).",
  "x-event-type": "mkg.logistics.trip.completed",
  "x-schema-version": 1,
  "x-producer": "mkg/logistics",
  "x-kind": "internal",
  "type": "object",
  "required": [
    "trip_id",
    "mode",
    "legs",
    "cargo",
    "actual_kg",
    "actual_cost",
    "cost_source",
    "departed_at",
    "arrived_at",
    "rule_version",
    "event_time"
  ],
  "properties": {
    "trip_id": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "type": "string",
      "enum": [
        "road",
        "waterway"
      ],
      "description": "Phương thức chính (chặng dài nhất)"
    },
    "vehicle_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "collection_order_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "delivery_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "leg_id",
          "seq",
          "mode",
          "from_kind",
          "to_kind",
          "distance_km",
          "route_source"
        ],
        "properties": {
          "leg_id": {
            "type": "string",
            "format": "uuid"
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "road",
              "waterway"
            ]
          },
          "from_kind": {
            "type": "string",
            "enum": [
              "plot",
              "collection_point",
              "facility",
              "customer_site",
              "point"
            ]
          },
          "from_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "to_kind": {
            "type": "string",
            "enum": [
              "plot",
              "collection_point",
              "facility",
              "customer_site",
              "point"
            ]
          },
          "to_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "distance_km": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{3}$"
          },
          "route_source": {
            "type": "string",
            "enum": [
              "routed",
              "digitised",
              "haversine",
              "manual"
            ]
          },
          "route_snapshot_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "mkg_logistics.route_snapshot: nguyên văn phản hồi định tuyến đã dùng + SHA-256 (mục 16)"
          },
          "network_version": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Phiên bản mạng đường thủy của bên cấp (ADR-0020, waterway_routes)"
          },
          "mass_kg": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+\\.[0-9]{3}$"
          }
        }
      }
    },
    "cargo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lot_ref",
          "mass_kg"
        ],
        "properties": {
          "lot_ref": {
            "type": "string",
            "format": "uuid"
          },
          "mass_kg": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{3}$"
          },
          "ticket_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      }
    },
    "planned_kg": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]{3}$"
    },
    "actual_kg": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{3}$"
    },
    "actual_cost": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$",
      "description": "VND numeric(18,2)"
    },
    "cost_source": {
      "type": "string",
      "enum": [
        "param_rate",
        "manual",
        "vessel_rate"
      ]
    },
    "departed_at": {
      "type": "string",
      "format": "date-time"
    },
    "arrived_at": {
      "type": "string",
      "format": "date-time"
    },
    "rule_version": {
      "type": "string"
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "vessel": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "vessel_ref",
        "code",
        "kind"
      ],
      "properties": {
        "vessel_ref": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ghe",
            "sa_lan",
            "truck"
          ]
        }
      }
    }
  }
}
